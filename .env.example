# =========================
# 기본 실행 환경
# =========================
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# =========================
# 인증/세션 보안
# 운영 환경(NODE_ENV=production)에서는
# RESET_TOKEN_HMAC_SECRET, TRUST_PROXY_CIDRS가 필수입니다.
# =========================
JWT_SECRET=change_me_to_long_random_string
JWT_ISSUER=glsoop
JWT_AUDIENCE=glsoop-client
RESET_TOKEN_HMAC_SECRET=change_me_to_long_random_string
TRUST_PROXY_CIDRS=loopback
LEGACY_TOKEN_SUNSET_AT=2026-03-07T00:00:00+09:00
# AUTH_COOKIE_DOMAIN=.glsoop.com

# =========================
# 법적 고지/약관 버전
# =========================
LEGAL_TERMS_VERSION=2026-02-27.terms.v1
LEGAL_TERMS_EFFECTIVE_DATE=2026-02-27
LEGAL_PRIVACY_VERSION=2026-02-27.privacy.v1
LEGAL_PRIVACY_EFFECTIVE_DATE=2026-02-27
LEGAL_MARKETING_VERSION=2026-02-27.marketing.v1
LEGAL_GUIDELINES_VERSION=2026-02-27.guidelines.v1
LEGAL_GUIDELINES_EFFECTIVE_DATE=2026-02-27
LEGAL_OPERATOR_NAME=김태훈
PRIVACY_CONTACT_DEPARTMENT=글숲 운영자
PRIVACY_CONTACT_EMAIL=glsoop1752@gmail.com
PRIVACY_CONTACT_PHONE=010-5152-8847
PRIVACY_DPO_NAME=김태훈

# =========================
# 메일 전송
# =========================
# 테스트/개발에서 true로 두면 인증 메일 전송을 생략합니다.
AUTH_SIGNUP_EMAIL_DRY_RUN=false
GMAIL_USER=your@gmail.com
GMAIL_PASS=your_app_password

# =========================
# 수익화 검증 모드
# pending_only | auto_active | receipt_inspect | live_verify
# App Review sandbox 구매 녹화 전에는 production 서버를 pending_only로 두지 않는다.
# 권장: MONETIZATION_VERIFY_MODE=live_verify + Apple Server API 키 설정
# 임시 sandbox QA: MONETIZATION_VERIFY_MODE=receipt_inspect
# =========================
MONETIZATION_VERIFY_MODE=pending_only
# live_verify 실패 시 처리 정책
# true: 즉시 오류 반환 / false: fallback 모드로 전환
MONETIZATION_VERIFY_LIVE_STRICT=false
MONETIZATION_VERIFY_LIVE_FALLBACK_MODE=receipt_inspect
MONETIZATION_VERIFY_TIMEOUT_MS=8000

# =========================
# 모바일 사진 저장 광고
# =========================
# true로 바꾸고 플랫폼별 보상형 광고 단위 ID를 넣으면
# 사진 저장 무료 일일 횟수 소진 후 보상형 광고를 요구합니다.
# false이거나 광고 단위 ID가 비어 있으면 기존처럼 사진 저장을 막지 않습니다.
PHOTO_SAVE_ADS_ENABLED=false
# 사용자가 하루에 광고 없이 저장할 수 있는 기본 횟수입니다. KST 기준으로 계산합니다.
PHOTO_SAVE_FREE_DAILY_LIMIT=3
# 보상형 광고 시청 후 저장권이 유효한 시간입니다.
PHOTO_SAVE_REWARDED_GRANT_TTL_MINUTES=30
# 프리미엄 사용자는 사진 저장 광고 게이트를 우회합니다.
PHOTO_SAVE_PREMIUM_ENTITLEMENT_KEY=premium:glsoop
# AdMob 보상형 광고 단위 ID입니다. App ID가 아니라 Ad Unit ID를 넣어야 합니다.
PHOTO_SAVE_ADMOB_ANDROID_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
PHOTO_SAVE_ADMOB_IOS_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# =========================
# 프리미엄 프로필 사진 업로드
# =========================
# 프로필 사진 업로드를 허용하는 프리미엄 권한 키입니다.
PROFILE_PHOTO_PREMIUM_ENTITLEMENT_KEY=premium:glsoop
# true이면 프리미엄 권한이 있는 사용자만 프로필 사진을 업로드할 수 있습니다.
# 로컬 QA에서만 false로 낮출 수 있고, 운영에서는 true를 권장합니다.
PROFILE_PHOTO_UPLOAD_PREMIUM_REQUIRED=true
# 업로드 가능한 원본 파일 최대 크기입니다. 기본값은 5MB입니다.
PROFILE_PHOTO_MAX_BYTES=5242880
# 서버 로컬 저장소 경로입니다. public 하위 경로여야 정적 파일로 노출됩니다.
PROFILE_PHOTO_UPLOAD_DIR=public/uploads/profile-photos

# =========================
# Apple 라이브 검증
# =========================
# MONETIZATION_APPLE_ENV=sandbox
# MONETIZATION_APPLE_ISSUER_ID=
# MONETIZATION_APPLE_KEY_ID=
# MONETIZATION_APPLE_PRIVATE_KEY=\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\"
# MONETIZATION_APPLE_BUNDLE_ID=com.example.app

# =========================
# Google 라이브 검증
# =========================
# MONETIZATION_GOOGLE_PACKAGE_NAME=com.example.app
# MONETIZATION_GOOGLE_SERVICE_ACCOUNT_EMAIL=play-verifier@project.iam.gserviceaccount.com
# MONETIZATION_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\"
# 서비스 계정 JSON을 직접 넣는 방식도 가능
# MONETIZATION_GOOGLE_SERVICE_ACCOUNT_JSON={\"client_email\":\"...\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n\"}

# =========================
# 웹훅 인증 시크릿
# =========================
# MONETIZATION_WEBHOOK_SECRET=change_me
# MONETIZATION_APPLE_WEBHOOK_SECRET=change_me_apple
# MONETIZATION_GOOGLE_WEBHOOK_SECRET=change_me_google

# =========================
# 푸시 알림
# =========================
# PUSH_DISPATCH_ENABLED=true
# PUSH_DISPATCH_INTERVAL_MS=15000
# PUSH_BATCH_SIZE=100
# MARKETING_PUSH_REMINDER_ENABLED=false
# MARKETING_PUSH_REMINDER_INCLUDE_AD_LABEL=false
